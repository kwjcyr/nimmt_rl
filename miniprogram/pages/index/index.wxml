<view class="lobby">
  <text class="title">🐂 牛头王</text>
  <text class="subtitle">6 Nimmt!</text>

  <view class="mode-card" bindtap="goSolo">
    <text class="mode-icon">🎮</text>
    <view class="mode-info">
      <text class="mode-name">单机对战</text>
      <text class="mode-desc">1人 vs 5个AI · 本地游戏</text>
    </view>
    <text class="mode-arrow">›</text>
  </view>

  <view class="mode-card mode-multi" bindtap="goMulti">
    <text class="mode-icon">🌐</text>
    <view class="mode-info">
      <text class="mode-name">多人联机</text>
      <text class="mode-desc">与真实玩家实时对战</text>
    </view>
    <text class="mode-arrow">›</text>
  </view>

  <view class="rules-box">
    <view class="rule-item">🃏 共100张牌（1-100），玩家各拿10张</view>
    <view class="rule-item">📋 牌桌5列，从小到大依次放入最合适的列</view>
    <view class="rule-item">💥 列满7张 → 拿走整列获得罚分🐂</view>
    <view class="rule-item">🏆 累计牛头最少者获胜，超过66分游戏结束</view>
  </view>
</view>

