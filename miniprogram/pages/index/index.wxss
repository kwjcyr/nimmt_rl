.lobby {
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 80rpx;
  font-weight: bold;
  color: #f9c74f;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 30rpx;
  color: #aaa;
  display: block;
  margin-bottom: 60rpx;
}

/* ===== 模式卡片 ===== */
.mode-card {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.mode-card.mode-multi {
  border-color: #4361ee;
  background: #141430;
}

.mode-icon {
  font-size: 64rpx;
  flex-shrink: 0;
}

.mode-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mode-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #eee;
  display: block;
}

.mode-desc {
  font-size: 26rpx;
  color: #aaa;
  display: block;
}

.mode-arrow {
  font-size: 56rpx;
  color: #555;
  flex-shrink: 0;
}

/* ===== 规则 ===== */
.rules-box {
  background: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 24rpx;
  padding: 32rpx;
  width: 100%;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.rule-item {
  font-size: 26rpx;
  color: #ccc;
  line-height: 1.9;
}

