<!-- ==================== START SCREEN ==================== -->
<view wx:if="{{phase === 'start'}}" class="start-screen">
  <text class="title">🐂 牛头王</text>
  <text class="subtitle">单机对战 · 1人 vs 5个AI</text>

  <view class="rules-box">
    <view class="rule-item">🃏 共 100 张牌（1-100），6位玩家各拿10张</view>
    <view class="rule-item">📋 牌桌5列，每列初始1张</view>
    <view class="rule-item">⚡ 所有人同时出牌，从小到大依次放入最合适的列</view>
    <view class="rule-item">💥 你的牌是某列第7张 → 拿走整列获得罚分🐂</view>
    <view class="rule-item">😱 你的牌比所有列末尾都小 → 自选一列拿走</view>
    <view class="rule-item">🏆 累计分数最少者获胜，超过 66分 游戏结束</view>
  </view>

  <button class="btn-start" bindtap="startGame">开始游戏 🎮</button>
</view>

<!-- ==================== GAME SCREEN ==================== -->
<block wx:if="{{phase !== 'start'}}">

  <!-- Title -->
  <view class="header">
    <text class="title-sm">🐂 牛头王 · 单机</text>
  </view>

  <!-- Scoreboard -->
  <scroll-view scroll-x class="scoreboard" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{scores}}" wx:key="index"
      class="score-card {{index === 0 ? 'human' : ''}} {{item >= 46 ? 'danger' : ''}}"
    >
      <text class="s-name">{{playerNames[index]}}</text>
      <text class="s-pts">{{item}} 🐂</text>
    </view>
  </scroll-view>

  <!-- Table Rows -->
  <view class="section">
    <text class="sec-title">📋 牌桌</text>
    <view class="rows-grid">
      <view wx:for="{{rowData}}" wx:key="index" class="row-wrap {{item.isFull ? 'full' : ''}}">
        <text class="row-label">列{{item.label}}</text>
        <scroll-view scroll-x class="row-cards" enhanced show-scrollbar="{{false}}">
          <view wx:for="{{item.cards}}" wx:for-item="c" wx:key="index"
            class="card {{c.cls}}">
            <text class="c-num">{{c.num}}</text>
            <text class="c-bull">{{c.bullsEmoji}}</text>
          </view>
        </scroll-view>
        <view class="slots">
          <view wx:for="{{item.slots}}" wx:key="index"
            class="slot {{item.filled ? 'filled' : ''}}">
          </view>
        </view>
        <text class="row-bulls-t">共{{item.totalBulls}}🐂</text>
      </view>
    </view>
  </view>

  <!-- Action Area -->
  <view class="action-area">
    <text class="action-msg">{{actionMsg}}</text>
    <view class="action-btns">
      <button wx:if="{{phase === 'pick' && selectedCard !== null}}" class="btn-confirm" bindtap="confirmPlay">出这张牌 ✔</button>
      <button wx:if="{{phase === 'end'}}" class="btn-restart" bindtap="startGame">再来一局 🔄</button>
    </view>
  </view>

  <!-- Hand Cards -->
  <view class="section hand-section">
    <view class="hand-header">
      <text class="sec-title">🃏 你的手牌</text>
      <text class="round-label">第{{round}}轮 · 剩余{{handData.length || 0}}张</text>
    </view>
    <scroll-view scroll-x class="hand-cards" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{handData}}" wx:key="index"
        class="card {{item.cls}}"
        bindtap="onCardClick"
        data-card="{{item.num}}"
      >
        <text class="c-num">{{item.num}}</text>
        <text class="c-bull">{{item.bullsEmoji}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- Log -->
  <view class="log-section">
    <scroll-view scroll-y class="log-scroll" enhanced show-scrollbar="{{false}}" scroll-top="{{logScrollTop}}">
      <view wx:for="{{logs}}" wx:key="index" class="log-entry {{item.cls}}">
        <text>{{item.msg}}</text>
      </view>
    </scroll-view>
  </view>

</block>

<!-- ==================== ROW PICK MODAL ==================== -->
<view wx:if="{{showRowModal}}" class="modal-mask" catchtap="">
  <view class="modal-box">
    <text class="modal-title">😱 你的牌最小！</text>
    <text class="modal-desc">你的牌比所有列末尾都小，必须选一列收走（你将获得该列的牛头罚分）</text>

    <view class="row-choices">
      <view wx:for="{{rowData}}" wx:key="index" class="choice-btn" bindtap="humanChooseRow" data-row="{{item.index}}">
        <view class="choice-info">
          <text class="choice-label">第{{item.label}}列（罚分：{{item.totalBulls}}🐂）</text>
          <view class="choice-cards">
            <block wx:for="{{item.cards}}" wx:for-item="mc" wx:key="index">
              <view class="mini-card">
                <text>{{mc.num}}</text>
              </view>
            </block>
          </view>
        </view>
        <text class="choice-arrow">→ 收走</text>
      </view>
    </view>
  </view>
</view>

<!-- ==================== END MODAL ==================== -->
<view wx:if="{{showEndModal}}" class="modal-mask" catchtap="">
  <view class="modal-box">
    <text class="modal-title">{{endTitle}}</text>
    <text class="modal-desc">{{endDesc}}</text>

    <view class="ranking-list">
      <view wx:for="{{endRanking}}" wx:key="index"
        class="rank-row {{index === 0 ? 'winner' : ''}} {{item.isYou ? 'you-row' : ''}}"
      >
        <text>{{item.medal}} {{item.name}}{{item.isYou ? '(你)' : ''}}</text>
        <text>{{item.score}}🐂</text>
      </view>
    </view>

    <button class="btn-restart" bindtap="startGame">再来一局 🔄</button>
    <button class="btn-back" bindtap="goBack">返回大厅 🏠</button>
  </view>
</view>

