/* ===== START SCREEN ===== */
.start-screen {
  padding: 80rpx 40rpx;
  text-align: center;
}
.title {
  font-size: 64rpx;
  font-weight: bold;
  color: #f9c74f;
  display: block;
  margin-bottom: 12rpx;
}
.title-sm {
  font-size: 40rpx;
  font-weight: bold;
  color: #f9c74f;
  text-align: center;
  display: block;
  margin-bottom: 12rpx;
}
.subtitle {
  font-size: 28rpx;
  color: #aaa;
  display: block;
  margin-bottom: 48rpx;
}
.rules-box {
  background: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 0 auto 48rpx auto;
  max-width: 600rpx;
}
.rule-item {
  font-size: 28rpx;
  color: #ccc;
  line-height: 1.8;
  margin-bottom: 8rpx;
}
.btn-start {
  background: linear-gradient(135deg, #f9c74f, #f3722c);
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  padding: 24rpx 80rpx;
  border-radius: 16rpx;
  width: auto !important;
}

/* ===== HEADER ===== */
.header {
  text-align: center;
  margin-bottom: 16rpx;
}

/* ===== SCOREBOARD ===== */
.scoreboard {
  white-space: nowrap;
  padding: 16rpx 8rpx;
  margin-bottom: 16rpx;
  display: flex;
  gap: 12rpx;
}
.score-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  min-width: 120rpx;
  flex-shrink: 0;
}
.score-card.human { border-color: #f9c74f; }
.score-card.danger .s-pts { color: #f3722c; }
.s-name { font-size: 22rpx; color: #aaa; }
.s-pts { font-size: 36rpx; font-weight: bold; }
.score-card.human .s-pts { color: #f9c74f; }

/* ===== SECTION COMMON ===== */
.section { margin-bottom: 20rpx; padding: 0 16rpx; }
.sec-title {
  font-size: 26rpx;
  color: #aaa;
  display: inline-block;
  margin-bottom: 10rpx;
}

/* ===== TABLE ROWS ===== */
.rows-grid { display: flex; flex-direction: column; gap: 12rpx; }
.row-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
}
.row-wrap.full { border-color: #f3722c; }
.row-label {
  font-size: 22rpx;
  color: #aaa;
  min-width: 80rpx;
  flex-shrink: 0;
}
.row-cards {
  display: flex;
  gap: 8rpx;
  flex: 1;
  white-space: nowrap;
}
.slots {
  display: flex;
  gap: 4rpx;
  margin-left: auto;
  flex-shrink: 0;
}
.slot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
  background: #0f3460;
}
.slot.filled { background: #4cc9f0; }
.row-bulls-t {
  font-size: 22rpx;
  color: #888;
  flex-shrink: 0;
  min-width: 70rpx;
  text-align: right;
}

/* ===== CARD STYLE ===== */
.card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 110rpx;
  border-radius: 12rpx;
  border: 3rpx solid #333;
  background: #fff;
  color: #222;
  font-weight: bold;
  flex-shrink: 0;
  position: relative;
}
.c-num { font-size: 30rpx; line-height: 1.2; }
.c-bull { font-size: 18rpx; color: #c0392b; margin-top: 2rpx; }
.card.b1 { background: #fff; }
.card.b2 { background: #fef9e7; border-color: #f39c12; }
.card.b3 { background: #fef3e2; border-color: #e67e22; }
.card.b5 { background: #fde8d8; border-color: #e74c3c; }
.card.b7 { background: #fdecec; border-color: #c0392b; color: #c0392b; }
.card.selectable { border-color: #4cc9f0; }
.card.selected {
  transform: translateY(-16rpx);
  box-shadow: 0 8rpx 24rpx rgba(249,199,79,0.5);
  border-color: #f9c74f !important;
  background: #fffbe6;
}

/* ===== HAND AREA ===== */
.hand-section { margin-bottom: 20rpx; }
.hand-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.round-label { font-size: 24rpx; color: #888; }
.hand-cards {
  display: flex;
  gap: 12rpx;
  white-space: nowrap;
  padding: 8rpx 0;
  min-height: 120rpx;
  align-items: flex-end;
}

/* ===== ACTION AREA ===== */
.action-area {
  background: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 16rpx 20rpx;
  min-height: 120rpx;
}
.action-msg {
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: block;
  color: #eee;
}
.action-btns { display: flex; gap: 16rpx; flex-wrap: wrap; }
.btn-confirm, .btn-restart {
  background: linear-gradient(135deg, #4cc9f0, #4361ee);
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  width: auto !important;
  display: inline-block;
}
.btn-restart {
  background: linear-gradient(135deg, #f9c74f, #f3722c);
}
.btn-back {
  background: #2a2a4a;
  color: #aaa;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  width: auto !important;
  display: inline-block;
  margin-top: 16rpx;
}

/* ===== LOG ===== */
.log-section {
  background: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 16rpx;
  padding: 16rpx;
  margin: 0 16rpx 32rpx;
  height: 360rpx;
}
.log-scroll { height: 100%; }
.log-entry {
  font-size: 24rpx;
  color: #ccc;
  padding: 6rpx 0;
  border-bottom: 1rpx solid #0f3460;
}
.log-entry.penalty { color: #f3722c; }
.log-entry.you { color: #f9c74f; }
.log-entry.system { color: #4cc9f0; }
.log-entry.warn { color: #f8961e; font-style: italic; }

/* ===== MODAL OVERLAY ===== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.75);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-box {
  background: #1a1a2e;
  border: 2rpx solid #0f3460;
  border-radius: 28rpx;
  padding: 40rpx;
  width: 85%;
  max-width: 600rpx;
  text-align: center;
}
.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}
.modal-desc {
  font-size: 26rpx;
  color: #aaa;
  line-height: 1.6;
  display: block;
  margin-bottom: 24rpx;
}
.row-choices { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 24rpx; }
.choice-btn {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #16213e;
  border: 2rpx solid #0f3460;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.choice-info { text-align: left; }
.choice-label { font-size: 24rpx; color: #aaa; margin-bottom: 8rpx; display: block; }
.choice-cards { display: flex; gap: 6rpx; }
.mini-card {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 68rpx;
  border-radius: 8rpx;
  border: 2rpx solid #444;
  background: #fff;
  color: #222;
  font-size: 22rpx;
  font-weight: bold;
}
.choice-arrow {
  font-size: 32rpx;
  color: #f3722c;
  font-weight: bold;
  flex-shrink: 0;
}

/* ===== RANKING ===== */
.ranking-list { text-align: left; margin-bottom: 24rpx; }
.rank-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 6rpx;
  background: #16213e;
  font-size: 28rpx;
}
.rank-row.winner { background: #2a2a0e; border: 2rpx solid #f9c74f; }
.rank-row.you-row { border: 2rpx solid #4cc9f0; }

